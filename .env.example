# --- Supabase (required) ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — server-only, NEVER expose to the browser.
# Used for admin tasks (e.g. sending emails, cron jobs). Not used by client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) — added in Phase 5 (Reminders), included now as a placeholder ---
RESEND_API_KEY=YOUR-RESEND-API-KEY
EMAIL_FROM="Raid Train Conductor <no-reply@yourdomain.com>"

# --- Cron (Phase 5) ---
# Shared secret checked against the `Authorization: Bearer <secret>` header on
# /api/cron/send-reminders. Vercel Cron sends this automatically once you set
# the same value as a Vercel env var; for any other scheduler, add the header
# yourself. Leave unset only for local testing — an unset value disables the
# auth check entirely.
CRON_SECRET=YOUR-RANDOM-CRON-SECRET
